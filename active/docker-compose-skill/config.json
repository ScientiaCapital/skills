{
  "name": "docker-compose-skill",
  "version": "1.0.0",
  "category": "Dev Tools",
  "activation_triggers": [
    "docker compose",
    "local dev",
    "postgres container",
    "redis local",
    "dev environment"
  ],
  "defaultPostgresVersion": "16-alpine",
  "defaultRedisVersion": "7-alpine",
  "defaultMongoVersion": "7",
  "defaultMySQLVersion": "8",
  "defaultPorts": {
    "postgres": 5432,
    "redis": 6379,
    "mongodb": 27017,
    "mysql": 3306,
    "rabbitmq": 5672,
    "rabbitmq-management": 15672,
    "elasticsearch": 9200,
    "meilisearch": 7700,
    "minio": 9000,
    "minio-console": 9001
  },
  "healthCheckDefaults": {
    "interval": "5s",
    "timeout": "5s",
    "retries": 5
  },
  "description": "Local dev environments with Docker Compose - multi-service setups, databases, hot reload, debugging. Use when: docker compose, local dev, postgres container, redis local, dev environment."
}
